PORT=3000
APP_ORIGIN=http://localhost:3000
DATABASE_PATH=./data/serendib.sqlite
# Run npm run admin:password. No default password exists.
ADMIN_PASSWORD_HASH=
INDEXING_ENABLED=false
# Use 1 only behind a trusted proxy that appends/overwrites the client IP.
TRUST_PROXY=0
# Optional owner email alerts. All three settings are required.
RESEND_API_KEY=
EMAIL_FROM=
NOTIFICATION_TO=
